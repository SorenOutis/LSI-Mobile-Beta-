+ * token clients). Only the SHA-256 hash of each token is stored — a database
+ * leak never exposes usable credentials, matching the approach Laravel
+ * Sanctum uses for its API tokens.
+ */
+return new class extends Migration
+{
+    public function up(): void
+    {
+        Schema::create('api_tokens', function (Blueprint $table) {
+            $table->id();
+            $table->foreignId('user_id')->constrained()->cascadeOnDelete();
+            $table->string('name');
+            $table->string('token', 64)->unique();
+            $table->timestamp('last_used_at')->nullable();
+            $table->timestamps();
+        });
+    }
+
+    public function down(): void
+    {
+        Schema::dropIfExists('api_tokens');
+    }
+};
diff --git a/routes/api.php b/routes/api.php
new file mode 100644
index 0000000..04314f4
--- /dev/null
+++ b/routes/api.php
@@ -0,0 +1,132 @@
+<?php
+
+use App\Http\Controllers\Api\BonusClaimController;
+use App\Http\Controllers\Api\ClaimXpController;
+use App\Http\Controllers\Api\DashboardExamsController;
+use App\Http\Controllers\Api\LeaderboardController;
+use App\Http\Controllers\Api\Mobile\MobileAuthController;
+use App\Http\Controllers\Api\Mobile\MobileCalendarController;
+use App\Http\Controllers\Api\XpHistoryController;
+use App\Http\Controllers\ActivityHubController;
+use App\Http\Controllers\AnonymousMessageController;
+use App\Http\Controllers\AssignmentController;
+use App\Http\Controllers\ChatHistoryController;
+use App\Http\Controllers\CourseController;
+use App\Http\Controllers\DashboardController;
+use App\Http\Controllers\ExamController;
+use App\Http\Controllers\GradeController;
+use App\Http\Controllers\ProfileKudoController;
+use App\Http\Controllers\PublicProfileController;
+use App\Http\Controllers\Settings\ProfileController;
+use App\Http\Controllers\UserFollowController;
+use Illuminate\Support\Facades\Route;
+
+/*
+|--------------------------------------------------------------------------
+| Mobile API
+|--------------------------------------------------------------------------
+|
+| JSON surface for the LSI mobile app. Lives in the `api` middleware group
+| (no CSRF, no session) and authenticates with personal access tokens
+| issued by POST api/mobile/auth/login.
+|
+| Data actions are deliberately the SAME methods the web app calls — the
+| only difference is that a request from this prefix receives JSON where
+| the web flow would receive a redirect. The web app is unaffected: it
+| never calls /api/mobile/* and its session + CSRF behavior is untouched.
+|
+*/
+
+Route::prefix('mobile')->group(function () {
+    // ── Auth ─────────────────────────────────────────────────────────
+    Route::post('auth/login', [MobileAuthController::class, 'login'])
+        ->middleware('throttle:mobile-login');
+
+    Route::middleware(['auth.mobile', 'banned.mobile'])->group(function () {
+        Route::post('auth/logout', [MobileAuthController::class, 'logout']);
+        Route::get('auth/two-factor', [MobileAuthController::class, 'twoFactorStatus']);
+        Route::post('auth/two-factor', [MobileAuthController::class, 'twoFactorEnable']);
+        Route::post('auth/two-factor/confirm', [MobileAuthController::class, 'twoFactorConfirm']);
+        Route::delete('auth/two-factor', [MobileAuthController::class, 'twoFactorDisable']);
+
+        Route::get('me', [MobileAuthController::class, 'me']);
+        Route::patch('me', [ProfileController::class, 'update']);
+        Route::put('password', [MobileAuthController::class, 'updatePassword']);
+
+        // ── Home / dashboard ─────────────────────────────────────────
+        Route::get('dashboard', [DashboardController::class, 'mobile'])
+            ->middleware('student.page.mobile:dashboard');
+        Route::get('calendar', [MobileCalendarController::class, '__invoke'])
+            ->middleware('student.page.mobile:calendar');
+        Route::get('dashboard-exams', DashboardExamsController::class);
+        Route::get('leaderboard', LeaderboardController::class)
+            ->middleware('student.page.mobile:leaderboard');
+        Route::get('grades', [GradeController::class, 'apiIndex'])
+            ->middleware('student.page.mobile:grades');
+
+        // ── Exams ────────────────────────────────────────────────────
+        Route::middleware('student.page.mobile:exams')->group(function () {
+            Route::get('exams', [ExamController::class, 'listing']);
+            Route::get('exams/{exam}', [ExamController::class, 'mobileShow']);
+            Route::get('exams/{exam}/review', [ExamController::class, 'review']);
+
+            Route::post('exams/{exam}/parts/{examPart}/start', [ExamController::class, 'startPart'])
+                ->middleware('throttle:exams.start');
+            Route::put('exams/{exam}/parts/{examPart}/answers', [ExamController::class, 'saveAnswers'])
+                ->middleware('throttle:exams.answers');
+            Route::post('exams/{exam}/parts/{examPart}/submit', [ExamController::class, 'submitPart'])
+                ->middleware('throttle:exams.submit');
+            Route::post('exams/{exam}/parts/{examPart}/status', [ExamController::class, 'partStatus'])
+                ->middleware('throttle:exams.status');
+        });
+
+        Route::get('activities', [ActivityHubController::class, 'listing'])
+            ->middleware('student.page.mobile:exams');
+
+        // ── Assignments ──────────────────────────────────────────────
+        Route::middleware('student.page.mobile:assignments')->group(function () {
+            Route::get('assignments', [AssignmentController::class, 'mobileIndex']);
+            Route::post('assignments/{assignment}/submit', [AssignmentController::class, 'store']);
+            Route::post('assignments/{assignment}/feedback-seen', [AssignmentController::class, 'markFeedbackSeen']);
+        });
+
+        // ── Courses ──────────────────────────────────────────────────
+        Route::middleware('student.page.mobile:courses')->group(function () {
+            Route::get('courses', [CourseController::class, 'mobileIndex']);
+            Route::get('courses/{course}', [CourseController::class, 'mobileShow']);
+            Route::get('courses/{course}/lessons/{lesson}', [CourseController::class, 'mobileLesson']);
+            Route::post('courses/{course}/lessons/{lesson}/quiz', [CourseController::class, 'submitQuiz'])
+                ->middleware('throttle:10,1');
+        });
+
+        // ── Gamification ─────────────────────────────────────────────
+        Route::post('claim-xp', ClaimXpController::class)->middleware('throttle:claim-xp');
+        Route::post('claim-bonus-xp', BonusClaimController::class)->middleware('throttle:claim-bonus-xp');
+        Route::get('users/{user}/xp-history', XpHistoryController::class);
+
+        // ── Chat ─────────────────────────────────────────────────────
+        Route::middleware('student.page.mobile:chats')->group(function () {
+            Route::get('chats', [ChatHistoryController::class, 'sessions']);
+            Route::post('chats', [ChatHistoryController::class, 'store'])->middleware('throttle:chats');
+            Route::get('chats/{session}/messages', [ChatHistoryController::class, 'messages']);
+            Route::post('chats/{session}/messages', [ChatHistoryController::class, 'message'])->middleware('throttle:chats');
+            Route::delete('chats/{session}', [ChatHistoryController::class, 'destroy']);
+        });
+
+        // ── NGL (anonymous messages) ─────────────────────────────────
+        Route::middleware('student.page.mobile:ngl')->group(function () {
+            Route::get('ngl', [AnonymousMessageController::class, 'feed']);
+            Route::post('ngl', [AnonymousMessageController::class, 'store']);
+            Route::post('ngl/{message}/like', [AnonymousMessageController::class, 'like']);
+        });
+
+        // ── Profiles & social ────────────────────────────────────────
+        Route::get('u/{user:public_id}', [PublicProfileController::class, 'mobileShow']);
+        Route::post('u/{user:public_id}/follow', [UserFollowController::class, 'store']);
+        Route::delete('u/{user:public_id}/follow', [UserFollowController::class, 'destroy']);
+        Route::post('u/{user:public_id}/kudos', [ProfileKudoController::class, 'store']);
+
+        // ── Sections ─────────────────────────────────────────────────
+        Route::post('sections/join-by-code', [ProfileController::class, 'joinByCode']);
+    });
+});
diff --git a/tests/Feature/MobileApiTest.php b/tests/Feature/MobileApiTest.php
new file mode 100644
index 0000000..56a5410
--- /dev/null
+++ b/tests/Feature/MobileApiTest.php
@@ -0,0 +1,548 @@
+<?php
+
+use App\Models\ApiToken;
+use App\Models\Exam;
+use App\Models\ExamPart;
+use App\Models\Setting;
+use App\Models\User;
+use Illuminate\Support\Facades\Hash;
+use Laravel\Fortify\Contracts\TwoFactorAuthenticationProvider;
+use Laravel\Fortify\Fortify;
+
+use function Pest\Laravel\post;
+
+/*
+|--------------------------------------------------------------------------
+| Mobile API (routes/api.php)
+|--------------------------------------------------------------------------
+|
+| The mobile app authenticates with a Bearer token issued by
+| POST /api/mobile/auth/login and then calls the /api/mobile/* JSON
+| surface. These tests cover auth, token lifecycle, 2FA, banned users,
+| and a representative slice of the data endpoints — plus a web-route
+| regression check to prove the session flow is untouched.
+|
+*/
+
+function mobileLogin(User $user, array $overrides = []): \Illuminate\Testing\TestResponse
+{
+    return post('/api/mobile/auth/login', array_merge([
+        'email' => $user->email,
+        'password' => 'password',
+    ], $overrides));
+}
+
+function mobileToken(User $user): string
+{
+    $token = mobileLogin($user)->assertOk()->json('token');
+
+    expect($token)->toBeString()->toStartWith(ApiToken::MOBILE_APP_PREFIX);
+
+    return $token;
+}
+
+// ── Login ────────────────────────────────────────────────────────────
+
+it('issues a token and user payload on valid credentials', function () {
+    $user = User::factory()->create(['name' => 'Mobile Student']);
+
+    $token = mobileLogin($user)
+        ->assertOk()
+        ->assertJsonStructure(['token', 'user' => ['id', 'public_id', 'name', 'email', 'avatar', 'sections', 'two_factor_enabled']])
+        ->assertJsonPath('user.name', 'Mobile Student')
+        ->assertJsonPath('user.email', $user->email)
+        ->json('token');
+
+    expect($token)->toBeString()->toStartWith(ApiToken::MOBILE_APP_PREFIX);
+
+    // The database stores the hash, never the usable plaintext.
+    expect(ApiToken::count())->toBe(1)
+        ->and(ApiToken::first()->token)->toBe(hash('sha256', $token))
+        ->and(ApiToken::first()->token)->not->toBe($token);
+});
+
+it('rejects an unknown email with a 422', function () {
+    post('/api/mobile/auth/login', ['email' => 'ghost@example.com', 'password' => 'password'])
+        ->assertUnprocessable()
+        ->assertJsonValidationErrors(['email']);
+});
+
+it('rejects a wrong password with a 422', function () {
+    $user = User::factory()->create();
+
+    mobileLogin($user, ['password' => 'wrong-password'])
+        ->assertUnprocessable()
+        ->assertJsonValidationErrors(['email']);
+
+    expect(ApiToken::count())->toBe(0);
+});
+
+it('honors the login_enabled setting with an admin exception', function () {
+    Setting::setGlobal('login_enabled', false);
+    Setting::setGlobal('login_disabled_message', 'Enrollment is closed.');
+
+    $student = User::factory()->create();
+    $admin = User::factory()->create(['is_admin' => true]);
+
+    mobileLogin($student)
+        ->assertUnprocessable()
+        ->assertJsonValidationErrors(['email']);
+
+    mobileLogin($admin)->assertOk()->assertJsonStructure(['token', 'user']);
+
+    Setting::setGlobal('login_enabled', true);
+});
+
+it('refuses to sign a banned student in', function () {
+    $banned = User::factory()->create(['is_banned' => true]);
+
+    mobileLogin($banned)
+        ->assertForbidden()
+        ->assertJsonStructure(['message']);
+
+    expect(ApiToken::count())->toBe(0);
+});
+
+// ── Token lifecycle ──────────────────────────────────────────────────
+
+it('authenticates requests with a valid Bearer token', function () {
+    $user = User::factory()->create();
+    $token = mobileToken($user);
+
+    $this->withHeaders(['Authorization' => 'Bearer '.$token])
+        ->getJson('/api/mobile/me')
+        ->assertOk()
+        ->assertJsonPath('user.email', $user->email)
+        ->assertJsonPath('user.name', $user->name);
+});
+
+it('rejects requests without a token', function () {
+    $this->getJson('/api/mobile/me')->assertUnauthorized();
+});
+
+it('rejects a malformed or unknown token', function () {
+    $this->withHeaders(['Authorization' => 'Bearer not-a-real-token'])
+        ->getJson('/api/mobile/me')
+        ->assertUnauthorized();
+
+    $this->withHeaders(['Authorization' => 'Token luav6m_abc'])
+        ->getJson('/api/mobile/me')
+        ->assertUnauthorized();
+});
+
+it('lets a user out via logout and the token stops working', function () {
+    $user = User::factory()->create();
+    $token = mobileToken($user);
+
+    expect(ApiToken::count())->toBe(1);
+
+    $this->withHeaders(['Authorization' => 'Bearer '.$token])
+        ->postJson('/api/mobile/auth/logout')
+        ->assertOk()
+        ->assertJsonPath('ok', true);
+
+    expect(ApiToken::count())->toBe(0);
+
+    $this->withHeaders(['Authorization' => 'Bearer '.$token])
+        ->getJson('/api/mobile/me')
+        ->assertUnauthorized();
+});
+
+it('updates the token last-used timestamp on a new request', function () {
+    $user = User::factory()->create();
+    $token = mobileToken($user);
+
+    $row = ApiToken::first();
+    expect($row->last_used_at)->toBeNull();
+
+    $this->withHeaders(['Authorization' => 'Bearer '.$token])->getJson('/api/mobile/me')->assertOk();
+
+    expect(ApiToken::first()->last_used_at)->not->toBeNull();
+});
+
+it('serves banned users a 403 on authenticated routes', function () {
+    $user = User::factory()->create();
+    $token = mobileToken($user);
+    $user->update(['is_banned' => true]);
+
+    $this->withHeaders(['Authorization' => 'Bearer '.$token])
+        ->getJson('/api/mobile/me')
+        ->assertForbidden()
+        ->assertJsonStructure(['message']);
+});
+
+// ── Two-factor login ─────────────────────────────────────────────────
+
+it('requests the second factor when 2FA is enabled', function () {
+    $user = User::factory()->create();
+    $user->forceFill([
+        'two_factor_secret' => encrypt('JBSWY3DPEHPK3PXP'),
+        'two_factor_recovery_codes' => encrypt(json_encode(['recovery-one', 'recovery-two'])),
+        'two_factor_confirmed_at' => now(),
+    ])->save();
+
+    mobileLogin($user)
+        ->assertOk()
+        ->assertJsonPath('requires_two_factor', true)
+        ->assertJsonMissing('token');
+
+    expect(ApiToken::count())->toBe(0);
+});
+
+it('issues a token when a valid TOTP code is supplied', function () {
+    $user = User::factory()->create();
+    $secret = 'JBSWY3DPEHPK3PXP';
+    $user->forceFill([
+        'two_factor_secret' => encrypt($secret),
+        'two_factor_recovery_codes' => encrypt(json_encode(['r-1', 'r-2'])),
+        'two_factor_confirmed_at' => now(),
+    ])->save();
+
+    // A real Google2FA OTP for the stored secret — the same library Fortify
+    // uses to verify, so this proves the login path accepts genuine codes.
+    $otp = (new PragmaRX\Google2FA\Google2FA($secret))->getCurrentOtp();
+
+    mobileLogin($user, ['two_factor_code' => $otp])
+        ->assertOk()
+        ->assertJsonStructure(['token', 'user'])
+        ->assertJsonMissing('requires_two_factor');
+});
+
+it('rejects an invalid 2FA code with a 422', function () {
+    $user = User::factory()->create();
+    $user->forceFill([
+        'two_factor_secret' => encrypt('JBSWY3DPEHPK3PXP'),
+        'two_factor_recovery_codes' => encrypt(json_encode(['r-1'])),
+        'two_factor_confirmed_at' => now(),
+    ])->save();
+
+    mobileLogin($user, ['two_factor_code' => '000000'])
+        ->assertUnprocessable()
+        ->assertJsonValidationErrors(['two_factor_code']);
+
+    expect(ApiToken::count())->toBe(0);
+});
+
+it('accepts a recovery code once, then revokes it', function () {
+    $user = User::factory()->create();
+    $user->forceFill([
+        'two_factor_secret' => encrypt('JBSWY3DPEHPK3PXP'),
+        'two_factor_recovery_codes' => encrypt(json_encode(['use-me-once'])),
+        'two_factor_confirmed_at' => now(),
+    ])->save();
+
+    mobileLogin($user, ['two_factor_code' => 'use-me-once'])->assertOk();
+
+    $codes = json_decode(Fortify::currentEncrypter()->decrypt($user->fresh()->two_factor_recovery_codes), true);
+    expect($codes)->not->toContain('use-me-once');
+
+    // The same code cannot be replayed.
+    mobileLogin($user, ['two_factor_code' => 'use-me-once'])
+        ->assertUnprocessable()
+        ->assertJsonValidationErrors(['two_factor_code']);
+});
+
+// ── Two-factor management ────────────────────────────────────────────
+
+it('enables, confirms and disables 2FA for the signed-in user', function () {
+    $user = User::factory()->create();
+    $token = mobileToken($user);
+    $headers = ['Authorization' => 'Bearer '.$token];
+
+    $this->withHeaders($headers)
+        ->postJson('/api/mobile/auth/two-factor')
+        ->assertOk()
+        ->assertJsonStructure(['secret', 'otpauth_url', 'recovery_codes']);
+
+    $secret = $user->fresh()->two_factor_secret;
+    expect($secret)->not->toBeNull();
+
+    $otp = (new PragmaRX\Google2FA\Google2FA(
+        Fortify::currentEncrypter()->decrypt($secret)
+    ))->getCurrentOtp();
+
+    $this->withHeaders($headers)
+        ->postJson('/api/mobile/auth/two-factor/confirm', ['code' => $otp])
+        ->assertOk()
+        ->assertJsonPath('enabled', true);
+
+    $this->withHeaders($headers)
+        ->getJson('/api/mobile/auth/two-factor')
+        ->assertJsonPath('enabled', true);
+
+    $this->withHeaders($headers)
+        ->deleteJson('/api/mobile/auth/two-factor')
+        ->assertOk()
+        ->assertJsonPath('enabled', false);
+
+    $user->refresh();
+    expect($user->two_factor_secret)->toBeNull()
+        ->and($user->two_factor_confirmed_at)->toBeNull();
+});
+
+it('rejects confirming 2FA with a bad code', function () {
+    $user = User::factory()->create();
+    $token = mobileToken($user);
+
+    $this->withHeaders(['Authorization' => 'Bearer '.$token])
+        ->postJson('/api/mobile/auth/two-factor')
+        ->assertOk();
+
+    $this->withHeaders(['Authorization' => 'Bearer '.$token])
+        ->postJson('/api/mobile/auth/two-factor/confirm', ['code' => '000000'])
+        ->assertUnprocessable();
+});
+
+// ── Account management ───────────────────────────────────────────────
+
+it('updates the profile through PATCH /api/mobile/me', function () {
+    $user = User::factory()->create();
+    $token = mobileToken($user);
+
+    $this->withHeaders(['Authorization' => 'Bearer '.$token])
+        ->patchJson('/api/mobile/me', ['name' => 'Renamed Student'])
+        ->assertOk()
+        ->assertJsonPath('user.name', 'Renamed Student');
+
+    expect($user->fresh()->name)->toBe('Renamed Student');
+});
+
+it('updates the password and the new password logs in', function () {
+    $user = User::factory()->create();
+    $token = mobileToken($user);
+
+    $this->withHeaders(['Authorization' => 'Bearer '.$token])
+        ->putJson('/api/mobile/password', [
+            'current_password' => 'password',
+            'password' => 'Str0ngNew!Pass',
+            'password_confirmation' => 'Str0ngNew!Pass',
+        ])
+        ->assertOk();
+
+    mobileLogin($user, ['password' => 'password'])->assertUnprocessable();
+    mobileLogin($user, ['password' => 'Str0ngNew!Pass'])->assertOk();
+});
+
+it('rejects a password change with the wrong current password', function () {
+    $user = User::factory()->create();
+    $token = mobileToken($user);
+
+    $this->withHeaders(['Authorization' => 'Bearer '.$token])
+        ->putJson('/api/mobile/password', [
+            'current_password' => 'nope',
+            'password' => 'Str0ngNew!Pass',
+            'password_confirmation' => 'Str0ngNew!Pass',
+        ])
+        ->assertUnprocessable()
+        ->assertJsonValidationErrors(['current_password']);
+});
+
+// ── Data endpoints ───────────────────────────────────────────────────
+
+it('serves the dashboard payload as JSON', function () {
+    $user = User::factory()->create();
+
+    $this->withHeaders(['Authorization' => 'Bearer '.mobileToken($user)])
+        ->getJson('/api/mobile/dashboard')
+        ->assertOk()
+        ->assertJsonStructure([
+            'claimXp' => ['enabled', 'canClaim', 'amount'],
+            'userStats' => ['totalXP', 'level', 'streak'],
+            'upcomingExams',
+            'announcements',
+            'courses',
+            'assignments',
+            'sectionLeaderboards',
+            'activeSeason',
+            'sectionName',
+        ]);
+});
+
+it('serves the exam listing grouped by season', function () {
+    $user = User::factory()->create();
+    Exam::factory()->published()->create(['title' => 'Open exam']);
+
+    $this->withHeaders(['Authorization' => 'Bearer '.mobileToken($user)])
+        ->getJson('/api/mobile/exams')
+        ->assertOk()
+        ->assertJsonStructure(['data' => [['seasonName', 'exams']], 'meta' => ['hasMore', 'nextCursor']]);
+});
+
+it('serves a full exam (parts + questions) for taking', function () {
+    $user = User::factory()->create();
+    $exam = Exam::factory()->published()->create(['title' => 'Take me']);
+    ExamPart::factory()->forExam($exam)->multipleChoice(2)->create();
+
+    $this->withHeaders(['Authorization' => 'Bearer '.mobileToken($user)])
+        ->getJson('/api/mobile/exams/'.$exam->id)
+        ->assertOk()
+        ->assertJsonStructure([
+            'exam' => ['id', 'title', 'parts', 'is_open_now', 'starts_at_iso', 'ends_at_iso'],
+            'submissions',
+            'partDeadlines',
+            'answerDrafts',
+            'xpAward',
+        ])
+        ->assertJsonPath('exam.title', 'Take me');
+});
+
+it('runs the start, save and submit part flow and rejects a second submit', function () {
+    $user = User::factory()->create();
+    $exam = Exam::factory()->published()->create();
+    $part = ExamPart::factory()->forExam($exam)->multipleChoice(2)->create();
+    $token = mobileToken($user);
+    $headers = ['Authorization' => 'Bearer '.$token];
+
+    $base = '/api/mobile/exams/'.$exam->id.'/parts/'.$part->id;
+
+    $this->withHeaders($headers)->postJson($base.'/start')
+        ->assertOk()
+        ->assertJsonStructure(['started_at', 'deadline']);
+
+    $this->withHeaders($headers)->putJson($base.'/answers', [
+        'answers' => [
+            ['question_number' => 1, 'answer' => 1],
+            ['question_number' => 2, 'answer' => 0],
+        ],
+    ])
+        ->assertOk()
+        ->assertJsonStructure(['saved_at', 'question_numbers', 'answered_count'])
+        ->assertJsonPath('answered_count', 2);
+
+    $this->withHeaders($headers)->postJson($base.'/submit', [
+        'answers' => [
+            ['question_number' => 1, 'answer' => 1],
+            ['question_number' => 2, 'answer' => 0],
+        ],
+    ])
+        ->assertOk()
+        ->assertJsonPath('submitted_part', $part->id);
+
+    // Single attempt per part, same rule as the web.
+    $this->withHeaders($headers)->postJson($base.'/submit', [
+        'answers' => [['question_number' => 1, 'answer' => 1]],
+    ])->assertConflict();
+
+    $this->withHeaders($headers)->postJson($base.'/status')
+        ->assertOk()
+        ->assertJsonStructure(['status', 'scored', 'score', 'is_late', 'grading_failed', 'awaiting_teacher_review', 'xp_award']);
+});
+
+it('serves grades, calendar, leaderboard, activities and assignments as JSON', function () {
+    $user = User::factory()->create();
+    $token = mobileToken($user);
+    $headers = ['Authorization' => 'Bearer '.$token];
+
+    $this->withHeaders($headers)->getJson('/api/mobile/grades')
+        ->assertOk()->assertJsonStructure(['subjectGrades']);
+
+    $this->withHeaders($headers)->getJson('/api/mobile/calendar')
+        ->assertOk()->assertJsonStructure(['todayKey']);
+
+    $this->withHeaders($headers)->getJson('/api/mobile/leaderboard')
+        ->assertOk()->assertJsonStructure(['leaderboards', 'selectedSeason']);
+
