diff --git a/app/Support/MobileApi.php b/app/Support/MobileApi.php
new file mode 100644
index 0000000..a1f24b3
--- /dev/null
+++ b/app/Support/MobileApi.php
@@ -0,0 +1,22 @@
+<?php
+
+namespace App\Support;
+
+use Illuminate\Http\Request;
+
+/**
+ * Helper for the handful of web controllers whose actions end in a redirect
+ * (back() / route redirect with a flash message). Mobile requests hit the
+ * exact same action through the /api/mobile/* routes; when the request comes
+ * from that surface the action returns JSON instead of a redirect.
+ *
+ * The gate is the URI prefix, not a header: it cannot be spoofed by a web
+ * client, and it keeps the web flow byte-for-byte identical.
+ */
+class MobileApi
+{
+    public static function isRequest(Request $request): bool
+    {
+        return $request->is('api/mobile/*');
+    }
+}
