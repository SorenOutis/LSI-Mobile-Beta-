diff --git a/app/Http/Middleware/AuthenticateWithMobileToken.php b/app/Http/Middleware/AuthenticateWithMobileToken.php
new file mode 100644
index 0000000..dbbd78f
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateWithMobileToken.php
@@ -0,0 +1,81 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\ApiToken;
+use App\Models\User;
+use Closure;
+use Illuminate\Auth\AuthManager;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Authenticate a stateless mobile client from its `Authorization: Bearer`
+ * token and bind the resolved user to the request AND the default (`web`)
+ * guard for the duration of this request.
+ *
+ * Why the web guard too: the codebase resolves the current user through
+ * `auth()->user()` (default guard) in policies, gates, and controllers.
+ * `SessionGuard::setUser()` only sets the in-memory user for this request —
+ * it never writes session state — so binding it here makes every existing
+ * authorization path work unchanged for token requests.
+ *
+ * The guard driver itself stays session-based; no new auth driver, no
+ * package dependency, no config change.
+ */
+class AuthenticateWithMobileToken
+{
+    public function __construct(
+        protected AuthManager $auth,
+    ) {}
+
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = $this->resolveUser($request);
+
+        if (! $user instanceof User) {
+            abort(401, 'Unauthenticated.');
+        }
+
+        $request->setUserResolver(fn (): ?User => $user);
+        $this->auth->guard('web')->setUser($user);
+
+        return $next($request);
+    }
+
+    /**
+     * Memoize on the request (not in process state) so Octane workers can
+     * never leak one request's user into the next.
+     */
+    private function resolveUser(Request $request): ?User
+    {
+        if ($request->attributes->has('mobile_api_user')) {
+            return $request->attributes->get('mobile_api_user');
+        }
+
+        $user = null;
+        $plain = $request->bearerToken();
+
+        if ($plain !== null && $plain !== '') {
+            $row = ApiToken::query()
+                ->where('token', hash('sha256', $plain))
+                ->with('user')
+                ->first();
+
+            if ($row !== null && $row->user !== null) {
+                // Throttle the write: at most one last_used_at touch per
+                // request, and no write at all within the last minute of
+                // polling (part status polls twice a second while grading).
+                if ($row->last_used_at === null || $row->last_used_at->lt(now()->subMinute())) {
+                    $row->forceFill(['last_used_at' => now()])->saveQuietly();
+                }
+
+                $user = $row->user;
+            }
+        }
+
+        $request->attributes->set('mobile_api_user', $user);
+
+        return $user;
+    }
+}
