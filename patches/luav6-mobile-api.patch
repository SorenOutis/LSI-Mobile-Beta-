diff --git a/app/Http/Controllers/Api/Mobile/MobileAuthController.php b/app/Http/Controllers/Api/Mobile/MobileAuthController.php
new file mode 100644
index 0000000..442bd49
--- /dev/null
+++ b/app/Http/Controllers/Api/Mobile/MobileAuthController.php
@@ -0,0 +1,211 @@
+<?php
+
+namespace App\Http\Controllers\Api\Mobile;
+
+use App\Http\Controllers\Controller;
+use App\Models\ApiToken;
+use App\Models\Setting;
+use App\Models\User;
+use App\Support\MobileUser;
+use Illuminate\Auth\Events\Login;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Validation\Rules\Password;
+use Illuminate\Validation\ValidationException;
+use Laravel\Fortify\Actions\ConfirmTwoFactorAuthentication;
+use Laravel\Fortify\Actions\DisableTwoFactorAuthentication;
+use Laravel\Fortify\Actions\EnableTwoFactorAuthentication;
+use Laravel\Fortify\Contracts\TwoFactorAuthenticationProvider;
+use Laravel\Fortify\Fortify;
+
+/**
+ * Authentication and account management for the stateless mobile client.
+ *
+ * Credential and two-factor verification deliberately reuse Fortify's own
+ * actions and TOTP provider, so the mobile app and the web app accept
+ * exactly the same codes and passwords.
+ */
+class MobileAuthController extends Controller
+{
+    public function login(Request $request): JsonResponse
+    {
+        $request->validate([
+            'email' => ['required', 'string', 'email'],
+            'password' => ['required', 'string'],
+            'two_factor_code' => ['sometimes', 'nullable', 'string', 'max:64'],
+        ]);
+
+        // Mirror EnsureLoginIsEnabled: when an admin disables login, only
+        // admins may still sign in.
+        if (! (bool) Setting::get('login_enabled', true)) {
+            $candidate = User::where(Fortify::username(), $request->input('email'))->first();
+
+            throw ValidationException::withMessages([
+                Fortify::username() => [Setting::get('login_disabled_message', 'Login is currently disabled.')],
+            ]);
+        }
+
+        $user = User::where(Fortify::username(), $request->input('email'))->first();
+
+        if ($user === null || ! Hash::check($request->input('password'), $user->password)) {
+            throw ValidationException::withMessages([
+                'email' => ['These credentials do not match our records.'],
+            ]);
+        }
+
+        if ($user->is_banned) {
+            return response()->json([
+                'message' => 'Your account is currently suspended. Please contact your teacher.',
+            ], 403);
+        }
+
+        if ($user->hasEnabledTwoFactorAuthentication()) {
+            $code = trim((string) $request->input('two_factor_code', ''));
+
+            if ($code === '') {
+                // Password is good; the client now needs the second factor.
+                return response()->json(['requires_two_factor' => true]);
+            }
+
+            if (! $this->verifyTwoFactorCode($user, $code)) {
+                throw ValidationException::withMessages([
+                    'two_factor_code' => ['The provided two factor authentication code was invalid.'],
+                ]);
+            }
+        }
+
+        [$token] = ApiToken::issue($user, 'mobile-app');
+
+        // Same hook the web login fires, so admin login notifications stay
+        // in parity regardless of which client signed the user in.
+        event(new Login('web', $user));
+
+        return response()->json([
+            'token' => $token,
+            'user' => MobileUser::present($user->fresh()),
+        ]);
+    }
+
+    public function logout(Request $request): JsonResponse
+    {
+        ApiToken::revokeAllFor($request->user());
+
+        return response()->json(['ok' => true]);
+    }
+
+    public function me(Request $request): JsonResponse
+    {
+        return response()->json(['user' => MobileUser::present($request->user()->fresh(['sections']))]);
+    }
+
+    public function updatePassword(Request $request): JsonResponse
+    {
+        $validated = $request->validate([
+            'current_password' => ['required', 'current_password'],
+            'password' => ['required', 'confirmed', 'string', Password::default()],
+        ]);
+
+        $request->user()->update([
+            'password' => Hash::make($validated['password']),
+        ]);
+
+        return response()->json([
+            'ok' => true,
+            'message' => 'Your password has been updated. Use it the next time you sign in.',
+        ]);
+    }
+
+    // ── Two-factor authentication ────────────────────────────────────
+
+    public function twoFactorStatus(Request $request): JsonResponse
+    {
+        return response()->json([
+            'enabled' => $request->user()->hasEnabledTwoFactorAuthentication(),
+        ]);
+    }
+
+    public function twoFactorEnable(Request $request): JsonResponse
+    {
+        $user = $request->user();
+
+        if ($user->two_factor_secret !== null && ! $user->hasEnabledTwoFactorAuthentication()) {
+            // A secret exists but was never confirmed: finish that flow
+            // (re-issuing here would orphan the codes the user already has).
+            throw ValidationException::withMessages([
+                'two_factor' => ['A two-factor setup is in progress. Confirm it with a code from your authenticator app.'],
+            ]);
+        }
+
+        if ($user->hasEnabledTwoFactorAuthentication()) {
+            throw ValidationException::withMessages([
+                'two_factor' => ['Two-factor authentication is already enabled.'],
+            ]);
+        }
+
+        app(EnableTwoFactorAuthentication::class)($user);
+        $user->refresh();
+
+        $secret = Fortify::currentEncrypter()->decrypt($user->two_factor_secret);
+
+        return response()->json([
+            'enabled' => false,
+            'secret' => $secret,
+            'otpauth_url' => app(TwoFactorAuthenticationProvider::class)->qrCodeUrl(
+                config('app.name'),
+                $user->{Fortify::username()},
+                $secret,
+            ),
+            'recovery_codes' => $user->recoveryCodes(),
+        ]);
+    }
+
+    public function twoFactorConfirm(Request $request): JsonResponse
+    {
+        $request->validate(['code' => ['required', 'string', 'max:64']]);
+
+        app(ConfirmTwoFactorAuthentication::class)($request->user(), $request->input('code'));
+
+        return response()->json(['enabled' => true]);
+    }
+
+    public function twoFactorDisable(Request $request): JsonResponse
+    {
+        app(DisableTwoFactorAuthentication::class)($request->user());
+
+        return response()->json(['enabled' => false]);
+    }
+
+    /**
+     * Accept either a TOTP code (verified with Fortify's own Google2FA
+     * provider — identical to the web flow) or one of the user's recovery
+     * codes, which are single-use.
+     */
+    private function verifyTwoFactorCode(User $user, string $code): bool
+    {
+        $secret = $user->two_factor_secret;
+
+        if ($secret !== null && $secret !== '') {
+            $verified = app(TwoFactorAuthenticationProvider::class)->verify(
+                Fortify::currentEncrypter()->decrypt($secret),
+                $code,
+            );
+
+            if ($verified) {
+                return true;
+            }
+        }
+
+        $recoveryCodes = $user->two_factor_recovery_codes !== null
+            ? $user->recoveryCodes()
+            : [];
+
+        if (in_array($code, $recoveryCodes, true)) {
+            $user->replaceRecoveryCode($code);
+
+            return true;
+        }
+
+        return false;
+    }
+}
