+<?php
+
+namespace App\Support;
+
+use App\Models\User;
+
+/**
+ * The user shape returned by the mobile API (login, /me, profile updates).
+ * `public_id` is the stable identifier for anything user-facing; the numeric
+ * `id` is included because several API payloads key on it.
+ */
+class MobileUser
+{
+    /**
+     * @return array<string, mixed>
+     */
+    public static function present(User $user): array
+    {
+        $user->loadMissing('sections:id,name');
+
+        return [
+            'id' => $user->id,
+            'public_id' => (string) $user->public_id,
+            'name' => $user->name,
+            'first_name' => $user->first_name,
+            'middle_name' => $user->middle_name,
+            'last_name' => $user->last_name,
+            'email' => $user->email,
+            'avatar' => $user->avatar,
+            'cover_photo' => $user->cover_photo,
+            'bio' => $user->bio,
+            'points' => (int) $user->points,
+            'exp' => (int) $user->exp,
+            'level' => (int) $user->level,
+            'current_streak' => (int) ($user->current_streak ?? 0),
+            'longest_streak' => (int) ($user->longest_streak ?? 0),
+            'is_admin' => (bool) $user->is_admin,
+            'is_super_admin' => (bool) $user->is_super_admin,
+            'is_banned' => (bool) $user->is_banned,
+            'profile_visibility' => $user->profile_visibility,
+            'profile_show_activity' => (bool) ($user->profile_show_activity ?? true),
+            'profile_show_sections' => (bool) ($user->profile_show_sections ?? true),
+            'profile_show_social' => (bool) ($user->profile_show_social ?? true),
+            'profile_show_achievements' => (bool) ($user->profile_show_achievements ?? true),
+            'blur_leaderboard' => (bool) $user->blur_leaderboard,
+            'two_factor_enabled' => $user->hasEnabledTwoFactorAuthentication(),
+            'sections' => $user->sections
+                ->map(fn ($section) => [
+                    'id' => $section->id,
+                    'name' => $section->name,
+                ])
+                ->values()
+                ->all(),
+            'created_at' => $user->created_at?->toIso8601String(),
+        ];
+    }
+}
