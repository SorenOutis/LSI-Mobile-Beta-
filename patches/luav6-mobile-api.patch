+<?php
+
+namespace App\Http\Middleware;
+
+use App\Support\StudentPageRegistry;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * API mirror of EnsureStudentPageIsAvailable: when an admin has disabled a
+ * student page, the web app renders the Inertia "unavailable" screen with a
+ * 423, while stateless clients receive the same 423 as JSON so they can show
+ * an honest empty state instead of a raw HTML page.
+ */
+class EnsureStudentPageIsAvailableMobile
+{
+    public function handle(Request $request, Closure $next, string $pageKey): Response
+    {
+        $control = StudentPageRegistry::controlFor($pageKey);
+
+        if ($request->user()?->is_admin || $control['mode'] !== StudentPageRegistry::MODE_DISABLED) {
+            return $next($request);
+        }
+
+        return response()->json([
+            'response' => $control['message']
+                ?: ($request->isMethod('get')
+                    ? 'This page is temporarily unavailable. Please check back later.'
+                    : 'This student page is currently unavailable.'),
+        ], 423);
+    }
+}
diff --git a/app/Models/ApiToken.php b/app/Models/ApiToken.php
new file mode 100644
index 0000000..b1f7c5a
--- /dev/null
+++ b/app/Models/ApiToken.php
@@ -0,0 +1,67 @@
+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Str;
+
+/**
+ * A personal access token for stateless (mobile) clients.
+ *
+ * The plaintext token is returned exactly once at creation time and is never
+ * persisted; only its SHA-256 hash is stored so the column can be looked up
+ * in O(1) and a leaked database never yields usable credentials.
+ */
+class ApiToken extends Model
+{
+    /**
+     * Prefix for the plaintext token, so a pasted token identifies at a
+     * glance which client issued it.
+     */
+    public const MOBILE_APP_PREFIX = 'luav6m_';
+
+    protected $fillable = [
+        'user_id',
+        'name',
+        'token',
+        'last_used_at',
+    ];
+
+    protected $casts = [
+        'last_used_at' => 'datetime',
+    ];
+
+    public function user(): BelongsTo
+    {
+        return $this->belongsTo(User::class);
+    }
+
+    /**
+     * Issue a fresh token for the user.
+     *
+     * @return array{0: static, 1: string} The persisted token row and the
+     *                                     one-time plaintext secret.
+     */
+    public static function issue(User $user, string $name = 'mobile-app'): array
+    {
+        $plain = self::MOBILE_APP_PREFIX.Str::random(40);
+        $hash = hash('sha256', $plain);
+
+        $token = static::create([
+            'user_id' => $user->id,
+            'name' => $name,
+            'token' => $hash,
+        ]);
+
+        return [$token, $plain];
+    }
+
+    /**
+     * Revoke every token issued to the user (mobile logout).
+     */
+    public static function revokeAllFor(User $user): void
+    {
+        static::where('user_id', $user->id)->delete();
+    }
+}
