@@ -0,0 +1,33 @@
+<?php
+
+namespace App\Http\Controllers\Api\Mobile;
+
+use App\Http\Controllers\CalendarController;
+use App\Http\Controllers\Controller;
+use App\Services\CalendarEventService;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+/**
+ * JSON calendar for the mobile app: the same event payload the Inertia
+ * Calendar page receives (see CalendarController), minus the page chrome.
+ */
+class MobileCalendarController extends Controller
+{
+    public function __construct(
+        protected CalendarEventService $calendarEvents,
+    ) {}
+
+    public function __invoke(Request $request): JsonResponse
+    {
+        $user = $request->user();
+
+        $from = now()->startOfMonth()->subMonths(CalendarController::MONTHS_BACK);
+        $to = now()->endOfMonth()->addMonths(CalendarController::MONTHS_FORWARD);
+
+        return response()->json(array_merge(
+            ['todayKey' => now()->toDateString()],
+            $this->calendarEvents->forUser($user, $from, $to),
+        ));
+    }
+}
