# LUA V6 backend URL (API routes live under /api on this origin).
#
# Live deployment (default, recommended):
#   EXPO_PUBLIC_API_URL=https://lsi.koamishin.com
#
# Local dev server (only while testing against a local LUA V6 checkout):
#   Web (dev)              : http://localhost:9000
#   Android emulator       : http://10.0.2.2:9000
#   iOS simulator          : http://localhost:9000
#   Physical device        : http://<your-machine-lan-ip>:9000   (same Wi-Fi)
#
# If you leave this unset, the app defaults to the live deployment
# (https://lsi.koamishin.com). Release builds require https://.
EXPO_PUBLIC_API_URL=https://lsi.koamishin.com
