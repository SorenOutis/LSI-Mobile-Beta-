# LUA V6 backend URL (API routes live under /api on this origin).
#
#   Web (dev)              : http://localhost:9000
#   Android emulator       : http://10.0.2.2:9000
#   iOS simulator          : http://localhost:9000
#   Physical device        : http://<your-machine-lan-ip>:9000   (same Wi-Fi)
#   Production (release)   : https://<your-domain>
#
# If you leave this unset, the app auto-detects:
#   - Android emulator -> 10.0.2.2:9000
#   - physical device  -> your dev machine's LAN IP:9000 (from hostUri)
#   - web              -> localhost:9000
#EXPO_PUBLIC_API_URL=http://localhost:9000
